# ── Unreal Engine project .gitignore ──────────────────────────────
# (Staged here; I move it to the project root once SuperClaudeBros2 exists.)

# Generated / build output — never committed
Binaries/
DerivedDataCache/
Intermediate/
Saved/
Build/
!Build/*/Resources/

# Visual Studio / Rider
.vs/
.vsconfig
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.idea/
*.xcodeproj/
*.xcworkspace/

# OS cruft
Thumbs.db
desktop.ini
.DS_Store

# Local-only notes
Saved/Screenshots/   # I'll copy out the ones I need to review; not version-controlled

# secrets (API keys) - never committed
/_secrets/


# Python bytecode from editor PyScripts
__pycache__/
*.pyc

# Generated verifier output (probes write these each run)
PyScripts/_world1_probe_result.txt
